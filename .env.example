# Copy to .env and fill in real values. Never commit .env.

# --- Google Cloud / BigQuery ---
GCP_PROJECT_ID=your-gcp-project-id
BQ_LOCATION=EU
BQ_DATASET_RAW=alacati_raw
BQ_DATASET_OPS=alacati_ops
BQ_DATASET_STAGING=alacati_staging
BQ_DATASET_MARTS=alacati_marts
# Path to the service account key file, kept OUTSIDE the repo
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repo/alacati-hava-sa.json

# --- Telegram ---
TELEGRAM_BOT_TOKEN=000000000:replace-with-botfather-token
TELEGRAM_CHAT_ID=000000000

# --- Kafka (Phase 3) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Airflow (Phase 2) ---
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=change-me
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_FERNET_KEY=generate-with-python-cryptography

# Open-Meteo needs no key. Call budget and all other parameters live in config/ingestion.yaml.

# --- Docker / Airflow (Phase 2, added) ---
# gcloud Application Default Credentials file on the HOST (created by
# `gcloud auth application-default login`). Mounted read-only into the containers as
# /opt/gcp/adc.json; inside Docker GOOGLE_APPLICATION_CREDENTIALS is set to that path.
GCP_ADC_FILE=C:/Users/<you>/AppData/Roaming/gcloud/application_default_credentials.json
# Shared by all Airflow containers (task tokens / log fetching). Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=generate-a-random-string
AIRFLOW_API_SECRET_KEY=generate-a-random-string
