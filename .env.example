# Copy to .env and fill in real values. Never commit .env.

# --- Google Cloud / BigQuery ---
GCP_PROJECT_ID=your-gcp-project-id
BQ_LOCATION=EU
BQ_DATASET_RAW=alacati_raw
BQ_DATASET_OPS=alacati_ops
BQ_DATASET_STAGING=alacati_staging
BQ_DATASET_MARTS=alacati_marts
# Local (non-Docker) runs use gcloud Application Default Credentials:
#   gcloud auth application-default login
# The Google libraries find them on their own, so leave this unset. Only set it if you
# deliberately switch to another credentials file (kept OUTSIDE the repo). Inside Docker
# it is always /opt/gcp/application_default_credentials.json (see GCP_ADC_DIR below).
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=000000000:replace-with-botfather-token
TELEGRAM_CHAT_ID=000000000
# Chat for alerts + the morning summary (e.g. a group or channel). Leave empty to use
# TELEGRAM_CHAT_ID; failure notifications always go to TELEGRAM_CHAT_ID.
TELEGRAM_BROADCAST_CHAT_ID=

# --- Kafka (Phase 3) ---
# Compose-internal listener (no host port is published). Local runs outside Docker
# cannot reach it; use `docker compose exec` (see docs/laptop-server.md).
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Airflow (Phase 2) ---
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=change-me
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_FERNET_KEY=generate-with-python-cryptography

# Open-Meteo needs no key. Call budget and all other parameters live in config/ingestion.yaml.

# --- Docker / Airflow (Phase 2, added) ---
# HOST folder that holds application_default_credentials.json (written by
# `gcloud auth application-default login`). The folder is mounted read-only at /opt/gcp
# in the scheduler and bot containers, so a re-login is picked up without a restart.
# Forward slashes, no trailing slash.
GCP_ADC_DIR=C:/Users/<you>/AppData/Roaming/gcloud
# Shared by all Airflow containers (task tokens / log fetching). Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=generate-a-random-string
AIRFLOW_API_SECRET_KEY=generate-a-random-string
