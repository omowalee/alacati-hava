{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alacati-hava/contracts/kafka/weather_raw.v1.schema.json",
  "title": "weather.raw message v1",
  "description": "One Open-Meteo response for one point (forecast location or marine zone) in one ingestion run. Topic: weather.raw. Key: '<source>:<point_id>'. Delivery is at-least-once: consumers must be idempotent on message_id. In Phase 1-2 the direct BigQuery loader builds the same object in memory before flattening it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "message_id", "run_id", "run_expected_messages", "source",
    "point_id", "fetched_at", "request", "grid", "model", "units", "hourly"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "message_id": { "type": "string", "format": "uuid", "description": "Unique per message; idempotency key." },
    "run_id": { "type": "string", "format": "uuid", "description": "Shared by all messages of one hourly ingestion run." },
    "run_expected_messages": {
      "type": "integer", "minimum": 1,
      "description": "Total messages in this run (locations + marine zones), so consumers can tell when a run is complete."
    },
    "source": { "enum": ["forecast", "marine"] },
    "point_id": {
      "type": "string", "pattern": "^[a-z][a-z0-9_]*$",
      "description": "locations[].id from config/locations.yaml when source=forecast, marine_zones[].id when source=marine."
    },
    "fetched_at": { "type": "string", "format": "date-time", "description": "UTC time the HTTP response was received." },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "forecast_days", "past_hours"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "forecast_days": { "type": "integer", "minimum": 1, "maximum": 16 },
        "past_hours": { "type": "integer", "minimum": 0 }
      }
    },
    "grid": {
      "type": "object",
      "description": "Grid cell Open-Meteo actually used.",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "elevation_m"],
      "properties": {
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "elevation_m": { "type": ["number", "null"] }
      }
    },
    "model": { "type": "string", "description": "Open-Meteo model selector, e.g. 'best_match'." },
    "units": {
      "type": "object",
      "description": "Unit per variable exactly as returned in hourly_units, e.g. {\"wind_speed_10m\": \"km/h\"}.",
      "additionalProperties": { "type": "string" }
    },
    "hourly": {
      "type": "array",
      "minItems": 1,
      "description": "time_utc must be unique within the array (JSON Schema cannot express this; the producer/loader rejects duplicates because (message_id, time_utc) is the raw table key).",
      "items": { "$ref": "#/$defs/hour" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "source": { "const": "forecast" } } },
      "then": { "properties": { "hourly": { "items": { "$ref": "#/$defs/forecast_hour" } } } }
    },
    {
      "if": { "properties": { "source": { "const": "marine" } } },
      "then": { "properties": { "hourly": { "items": { "$ref": "#/$defs/marine_hour" } } } }
    }
  ],
  "$defs": {
    "num": { "type": ["number", "null"] },
    "hour": {
      "type": "object",
      "required": ["time_utc"],
      "properties": { "time_utc": { "type": "string", "format": "date-time" } }
    },
    "forecast_hour": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_utc"],
      "properties": {
        "time_utc": { "type": "string", "format": "date-time" },
        "temperature_2m": { "$ref": "#/$defs/num" },
        "precipitation": { "$ref": "#/$defs/num" },
        "precipitation_probability": { "$ref": "#/$defs/num" },
        "weather_code": { "type": ["integer", "null"], "minimum": 0, "maximum": 99 },
        "cape": { "$ref": "#/$defs/num" },
        "wind_speed_10m": { "$ref": "#/$defs/num" },
        "wind_direction_10m": { "$ref": "#/$defs/num" },
        "wind_gusts_10m": { "$ref": "#/$defs/num" }
      }
    },
    "marine_hour": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_utc"],
      "properties": {
        "time_utc": { "type": "string", "format": "date-time" },
        "wave_height": { "$ref": "#/$defs/num" },
        "wave_direction": { "$ref": "#/$defs/num" },
        "wave_period": { "$ref": "#/$defs/num" },
        "wind_wave_height": { "$ref": "#/$defs/num" },
        "swell_wave_height": { "$ref": "#/$defs/num" }
      }
    }
  }
}
