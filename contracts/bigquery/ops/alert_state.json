  },
  {
    "name": "notified_end_utc",
    "type": "TIMESTAMP",
    "mode": "REQUIRED",
    "description": "Window end in the last notification"
  },
  {
    "name": "notified_regions",
    "type": "STRING",
    "mode": "REPEATED",
    "description": "affected_regions in the last notification"
  },
  {
    "name": "last_notified_status",
    "type": "STRING",
    "mode": "REQUIRED",
