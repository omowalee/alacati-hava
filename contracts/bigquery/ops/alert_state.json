  {
    "name": "first_detected_at",
    "type": "TIMESTAMP",
    "mode": "REQUIRED",
    "description": "When the event was first seen"
  },
  {
    "name": "last_updated_at",
    "type": "TIMESTAMP",
    "mode": "REQUIRED",
    "description": "Last time any field changed"
  },
  {
    "name": "last_seen_run_id",
    "type": "STRING",
    "mode": "REQUIRED",
