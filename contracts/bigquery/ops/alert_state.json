  {
    "name": "peak_unit",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Unit of peak_value"
  },
  {
    "name": "peak_time_utc",
    "type": "TIMESTAMP",
    "mode": "REQUIRED",
    "description": "Hour of the peak"
  },
  {
    "name": "affected_regions",
    "type": "STRING",
    "mode": "REPEATED",
