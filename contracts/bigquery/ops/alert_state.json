      {
        "name": "region_id",
        "type": "STRING",
        "mode": "REQUIRED",
        "description": "Region id"
      },
      {
        "name": "level",
        "type": "STRING",
        "mode": "REQUIRED",
        "description": "yellow | orange | red"
      }
    ]
  },
  {
    "name": "affected_locations",
    "type": "STRING",
    "mode": "REPEATED",
    "description": "Location / marine zone ids"
  },
  {
    "name": "revision",
    "type": "INT64",
    "mode": "REQUIRED",
