  },
  {
    "name": "wind_gusts_10m",
    "type": "FLOAT64",
    "mode": "NULLABLE",
    "description": "Open-Meteo wind_gusts_10m [km/h]"
  },
  {
    "name": "wind_direction_10m",
    "type": "FLOAT64",
    "mode": "NULLABLE",
    "description": "Open-Meteo wind_direction_10m [degrees]"
  },
  {
    "name": "wave_height",
    "type": "FLOAT64",
    "mode": "NULLABLE",
    "description": "Open-Meteo wave_height [m]"
  },
  {
    "name": "onshore_angle_deg",
    "type": "FLOAT64",
    "mode": "NULLABLE",
    "description": "0 = straight onshore, 180 = straight offshore"
  },
  {
    "name": "exposure",
    "type": "FLOAT64",
    "mode": "NULLABLE",
    "description": "Exposure factor 0-1"
  },
  {
    "name": "shore_verified",
    "type": "BOOL",
    "mode": "REQUIRED",
    "description": "False = orientation not confirmed yet; UI shows a hint"
