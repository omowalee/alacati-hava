  {
    "name": "is_daytime",
    "type": "BOOL",
    "mode": "REQUIRED",
    "description": "Inside beach_score.yaml daytime_local_hours"
  },
  {
    "name": "wind_speed_10m",
    "type": "FLOAT64",
