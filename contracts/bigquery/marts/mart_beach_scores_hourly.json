    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Beach id"
  },
  {
    "name": "location_name",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Display name"
  },
  {
    "name": "region_id",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Region id"
  },
  {
    "name": "time_utc",
    "type": "TIMESTAMP",
    "mode": "REQUIRED",
