# Copy to .streamlit/secrets.toml (git-ignored) or paste into Community Cloud "Secrets".
GCP_PROJECT_ID = "your-gcp-project-id"
BQ_DATASET_MARTS = "alacati_marts"

[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "replace-me"
private_key = "paste the private_key value from your service account JSON here"
client_email = "dashboard-reader@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
token_uri = "https://oauth2.googleapis.com/token"
